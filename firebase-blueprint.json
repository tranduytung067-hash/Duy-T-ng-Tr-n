{
  "entities": {
    "UserPermission": {
      "title": "UserPermission",
      "description": "User permission and account configuration including lock status.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "The unique email address of the account"
        },
        "password": {
          "type": "string",
          "description": "Password for standard authentication"
        },
        "role": {
          "type": "string",
          "description": "The role of the user"
        },
        "mappedEmployee": {
          "type": "string",
          "description": "Optional employee name mapping"
        },
        "hoVaTen": {
          "type": "string",
          "description": "Full name of the user"
        },
        "vtbhCode": {
          "type": "string",
          "description": "VTBH system code"
        },
        "channel": {
          "type": "string",
          "description": "Sales channel"
        },
        "locked": {
          "type": "boolean",
          "description": "True if the account is locked and cannot log in"
        },
        "avatarUrl": {
          "type": "string",
          "description": "Base64 or external URL string containing compressed avatar image"
        },
        "soLuotTruyCap": {
          "type": "integer",
          "description": "Number of accesses"
        }
      },
      "required": [
        "email",
        "role"
      ]
    },
    "LeaveRequest": {
      "title": "LeaveRequest",
      "description": "Employee leave request ticket with approval status",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "creatorName": {
          "type": "string"
        },
        "creatorEmail": {
          "type": "string"
        },
        "createdAt": {
          "type": "string"
        },
        "offDate": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "details": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "approvedBy": {
          "type": "string"
        },
        "approvedAt": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "creatorName",
        "creatorEmail",
        "offDate",
        "reason",
        "status"
      ]
    },
    "SalesNote": {
      "title": "SalesNote",
      "description": "Sales note or remark for each employee, adjustable by Supervisor and synchronized to all.",
      "type": "object",
      "properties": {
        "employeeName": {
          "type": "string",
          "description": "The name of the employee"
        },
        "note": {
          "type": "string",
          "description": "The sales note or remark content"
        },
        "updatedBy": {
          "type": "string",
          "description": "Email or name of the supervisor who updated it"
        },
        "updatedAt": {
          "type": "string",
          "description": "Timestamp when it was updated"
        }
      },
      "required": [
        "employeeName",
        "note"
      ]
    },
    "ProgressCycle": {
      "title": "ProgressCycle",
      "description": "Stores the progress cycle start and end dates configured by supervisors.",
      "type": "object",
      "properties": {
        "startDate": {
          "type": "string",
          "description": "Start date of the cycle (YYYY-MM-DD)"
        },
        "endDate": {
          "type": "string",
          "description": "End date of the cycle (YYYY-MM-DD)"
        },
        "updatedBy": {
          "type": "string",
          "description": "Name or email of supervisor who updated it"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of when it was updated"
        }
      },
      "required": [
        "startDate",
        "endDate"
      ]
    },
    "MarketEvaluation": {
      "title": "MarketEvaluation",
      "description": "Market service evaluation ticket for field sales personnel.",
      "type": "object",
      "properties": {
        "ngay": {
          "type": "string"
        },
        "nguoiDanhGia": {
          "type": "string"
        },
        "nhanVien": {
          "type": "string"
        },
        "hangCanHetDate": {
          "type": "boolean"
        },
        "trungBayKhongDat": {
          "type": "boolean"
        },
        "khieuNaiBoDiemBan": {
          "type": "boolean"
        },
        "capNhatThongTinSai": {
          "type": "boolean"
        },
        "khongDamBaoWPP": {
          "type": "boolean"
        },
        "viPhamLiemChinh": {
          "type": "boolean"
        },
        "tongLuotViengTham": {
          "type": "integer"
        },
        "soLuotKhongDat": {
          "type": "integer"
        },
        "tiLeKhongDat": {
          "type": "integer"
        },
        "trangThai": {
          "type": "string"
        },
        "ghiChu": {
          "type": "string"
        },
        "seenBy": {
          "type": "array"
        }
      },
      "required": [
        "ngay",
        "nguoiDanhGia",
        "nhanVien",
        "tongLuotViengTham",
        "soLuotKhongDat",
        "tiLeKhongDat",
        "trangThai"
      ]
    },
    "AttendanceHistory": {
      "title": "AttendanceHistory",
      "description": "Historical attendance snapshot for an employee in a specific cycle",
      "type": "object",
      "properties": {
        "employeeName": {
          "type": "string"
        },
        "cycleId": {
          "type": "string"
        },
        "cycleName": {
          "type": "string"
        },
        "attendance": {
          "type": "object"
        },
        "savedBy": {
          "type": "string"
        },
        "savedAt": {
          "type": "string"
        }
      },
      "required": [
        "employeeName",
        "cycleId",
        "cycleName",
        "attendance"
      ]
    },
    "CompetitionProgram": {
      "title": "CompetitionProgram",
      "description": "Centralized competition program scheme and configuration",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "shortTitle": {
          "type": "string"
        },
        "time": {
          "type": "string"
        },
        "isActive": {
          "type": "boolean"
        },
        "range": {
          "type": "string"
        },
        "sheetTab": {
          "type": "string"
        },
        "isCustom": {
          "type": "boolean"
        },
        "intro": {
          "type": "string"
        },
        "columns": {
          "type": "array"
        },
        "conditions": {
          "type": "array"
        },
        "tiers": {
          "type": "array"
        },
        "details": {
          "type": "array"
        },
        "updatedBy": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "shortTitle",
        "time"
      ]
    },
    "CompetitionProgramLog": {
      "title": "CompetitionProgramLog",
      "description": "Audit trail log for competition program configuration changes",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "programId": {
          "type": "string"
        },
        "programTitle": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "performedBy": {
          "type": "string"
        },
        "timestamp": {
          "type": "string"
        },
        "details": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "programId",
        "action",
        "performedBy",
        "timestamp"
      ]
    },
    "CustomerSurvey": {
      "title": "CustomerSurvey",
      "description": "Customer gift survey submission metadata synchronized with the Khảo Sát Google Sheet.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "customerCode": {
          "type": "string",
          "maxLength": 80
        },
        "customerName": {
          "type": "string",
          "maxLength": 240
        },
        "customerEmployee": {
          "type": "string",
          "maxLength": 120
        },
        "surveyor": {
          "type": "string",
          "maxLength": 120
        },
        "giftStatus": {
          "type": "string",
          "maxLength": 80
        },
        "giftName": {
          "type": "string",
          "maxLength": 200
        },
        "giftQty": {
          "type": "integer"
        },
        "customerFeedback": {
          "type": "string",
          "maxLength": 1500
        },
        "combinedOpinion": {
          "type": "string",
          "maxLength": 2000
        },
        "imageUrl": {
          "type": "string",
          "maxLength": 600
        },
        "sheetSynced": {
          "type": "boolean"
        },
        "submittedAt": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": [
        "id",
        "customerCode",
        "customerName",
        "surveyor",
        "giftStatus",
        "combinedOpinion",
        "sheetSynced",
        "submittedAt"
      ]
    }
  },
  "firestore": {
    "user_permissions/{email}": {
      "schema": "UserPermission",
      "description": "Stores user credentials and locking states, synchronized across all devices"
    },
    "leave_requests/{requestId}": {
      "schema": "LeaveRequest",
      "description": "Stores employee leave requests and their approval statuses"
    },
    "sales_notes/{employeeName}": {
      "schema": "SalesNote",
      "description": "Stores sales notes and remarks for employees, synchronized to everyone"
    },
    "app_settings/{settingId}": {
      "schema": "ProgressCycle",
      "description": "Stores global app settings like progress cycle, theme, and survey config"
    },
    "market_evaluations/{evaluationId}": {
      "schema": "MarketEvaluation",
      "description": "Stores market service evaluation records synchronized across supervisors, OMs, and employees"
    },
    "attendance_history/{historyId}": {
      "schema": "AttendanceHistory",
      "description": "Stores archived snapshots of historical attendance per employee and cycle"
    },
    "competition_programs/{programId}": {
      "schema": "CompetitionProgram",
      "description": "Stores centralized competition program configurations and reward structures"
    },
    "competition_program_logs/{logId}": {
      "schema": "CompetitionProgramLog",
      "description": "Stores audit log history of changes to competition programs"
    },
    "customer_surveys/{surveyId}": {
      "schema": "CustomerSurvey",
      "description": "Stores real-time customer gift survey status and metadata synced with the Khảo Sát sheet"
    }
  }
}
